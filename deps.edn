;; parlor: the browser's screens over doorbell's question store, in re-frame,
;; drawn with Reagent. Browser only: source-code/parlor/ holds .cljs files.
{:paths ["source-code"]

 :deps
 {;; the app's state and its events and subscriptions
  re-frame/re-frame              {:mvn/version "1.4.7"}
  ;; the root screen drawn into the page, with React (react and react-dom
  ;; come from the app's package.json)
  reagent/reagent                {:mvn/version "2.0.1"}
  ;; the question store parlor keeps its answers from, and the changes a
  ;; write's answer says it touched
  io.github.p4ulcristian/doorbell {:git/tag "v0.5.2" :git/sha "88ad38f"}
  ;; the address bar followed into re-frame, and moves to a page
  ;; (it brings wire, which the app's send-message! carries)
  io.github.p4ulcristian/mailroom {:git/tag "v0.7.1" :git/sha "0d67929"}
  ;; the language of an address, and an address made in a language
  io.github.p4ulcristian/dictionary {:git/tag "v0.2.1" :git/sha "bfea9bd"}
  ;; "can I?"'s answer checked by its shape, through the app's wire
  io.github.p4ulcristian/wire    {:git/tag "v0.2.0" :git/sha "d66b7cb"}
  ;; the start's settings checked by their shapes
  metosin/malli                  {:mvn/version "0.20.3"}}

 :aliases
 {;; the tests, through shadow-cljs:  npm install && npx shadow-cljs compile test
  :cljs {:extra-paths ["test-code"]
         :extra-deps  {thheller/shadow-cljs {:mvn/version "3.5.7"}}}}}
