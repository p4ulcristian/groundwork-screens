;; groundwork-screens: the browser's screens over groundwork-live-updates's question store, in re-frame,
;; drawn with Reagent. Browser only: source-code/groundwork_screens/ holds .cljs files.
{:paths ["source-code"]

 :deps
 {;; the app's state and its events and subscriptions
  re-frame/re-frame              {:mvn/version "1.4.7"}
  ;; the root screen drawn into the page, with React (react and react-dom
  ;; come from the app's package.json)
  reagent/reagent                {:mvn/version "2.0.1"}
  ;; the question store groundwork-screens keeps its answers from, and the changes a
  ;; write's answer says it touched
  ;; on its tidy-up branch, not released: an ask with no answer is bridge's :groundwork-bridge/no-answer
  io.github.p4ulcristian/groundwork-live-updates {:git/tag "v0.5.9" :git/sha "60cab75"}
  ;; the address bar followed into re-frame, and moves to a page; an
  ;; answer told from a refusal (it brings groundwork-shaped-json, which the app's send-message! carries)
  ;; on its tidy-up branch, not released: a refusal is a named reason, declared on its handler;
  ;; send-message! takes :keep-alive?; go-to-page! takes :push or :replace; :may-leave? is
  ;; asked with the move, and finish-move! finishes one it held back; an sse line tells its break
  io.github.p4ulcristian/groundwork-bridge {:git/tag "v0.7.9" :git/sha "8967097aa49894c47fbe928fafb7798b25f34a69"}
  ;; the language of an address, and an address made in a language
  ;; on its tidy-up branch, not released: a key names its ICU argument with - read as _;
  ;; the browser's make-text, which tr calls
  io.github.p4ulcristian/groundwork-languages {:git/tag "v0.4.3" :git/sha "75b7b308bbdeb3c480bf32a2c512bf915b2a43c0"}
  ;; "can I?"'s answer checked by its shape, through the app's shaper
  io.github.p4ulcristian/groundwork-shaped-json    {:git/tag "v0.2.1" :git/sha "900a84d"}
  ;; the start's settings checked by their shapes
  metosin/malli                  {:mvn/version "0.20.3"}}

 :aliases
 {;; the tests, through shadow-cljs:  npm install && npx shadow-cljs compile test
  :cljs {:extra-paths ["test-code"]
         :extra-deps  {thheller/shadow-cljs {:mvn/version "3.5.7"}}}}}
