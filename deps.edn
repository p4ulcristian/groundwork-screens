;; groundwork-screens: the browser's screens over groundwork-live-updates's question store, in re-frame,
;; drawn with Reagent (in groundwork-screens.views alone), and the address bar they follow.
;; Browser only: source-code/groundwork_screens/ holds .cljs files.
{:paths ["source-code"]

 :deps
 {;; the app's state and its events and subscriptions
  re-frame/re-frame              {:mvn/version "1.4.7"}
  ;; the root screen drawn into the page, with React (react and react-dom
  ;; come from the app's package.json); groundwork-screens.views only
  reagent/reagent                {:mvn/version "2.0.1"}
  ;; the question store groundwork-screens keeps its answers from, and the changes a
  ;; write's answer says it touched
  io.github.p4ulcristian/groundwork-live-updates {:git/tag "v0.6.2" :git/sha "ff934b1f1d466a4f15844f918b9cafbea1c9018f"}
  ;; an answer told from a refusal, groundwork-steps's shape (the sends are the app's, handed in)
  io.github.p4ulcristian/groundwork-steps {:git/tag "v0.1.0" :git/sha "ed9458e"}
  ;; the address bar followed (groundwork-screens.routes): the pages matched and their addresses made
  metosin/reitit-frontend        {:mvn/version "0.11.0"}
  ;; the language of an address, and an address made in a language
  ;; on its tidy-up branch, not released: a key names its ICU argument with - read as _;
  ;; the browser's make-text, which tr calls
  io.github.p4ulcristian/groundwork-languages {:git/tag "v0.4.4" :git/sha "68368a0"}
  ;; "can I?"'s answer checked by its shape, through the app's shaper
  io.github.p4ulcristian/groundwork-shaped-json    {:git/tag "v0.2.2" :git/sha "1c0fcf9"}
  ;; the start's settings checked by their shapes
  metosin/malli                  {:mvn/version "0.20.3"}}

 :aliases
 {;; the tests, through shadow-cljs:  npm install && npx shadow-cljs compile test
  :cljs {:extra-paths ["test-code"]
         :extra-deps  {thheller/shadow-cljs {:mvn/version "3.5.10"}}}}}
